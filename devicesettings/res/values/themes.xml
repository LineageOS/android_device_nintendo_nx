<resources>
    <style name="Theme.Material3.DayNight.NoActionBar.Leanback">
        <!--
             Keep in sync with whatever Theme.AppCompat.LeanbackBase
             adds on top of Theme.AppCompat.NoActionBar

             Changes made:
             - viewInflaterClass: Removed
             - ?android:attr/colorAccent -> ?attr/colorAccent
             - ?android:attr/colorPrimary -> ?attr/colorPrimary
             - ?android:attr/colorPrimaryDark -> ?attr/colorPrimaryDark
             - @color/lb_default_brand_color -> ?attr/colorPrimary
             - @color/lb_default_brand_color_dark -> ?attr/colorPrimaryDark
        -->
        <item name="playbackProgressPrimaryColor">?attr/colorAccent</item>
        <item name="playbackControlsIconHighlightColor">?attr/colorAccent</item>
        <item name="defaultBrandColor">?attr/colorPrimary</item>
        <item name="android:colorPrimary">?attr/colorPrimary</item>
        <item name="defaultBrandColorDark">?attr/colorPrimaryDark</item>
        <item name="android:colorPrimaryDark">?attr/colorPrimaryDark</item>

        <item name="android:windowOverscan">true</item>
        <item name="guidedStepTheme">@style/Theme.AppCompat.Leanback.GuidedStep</item>

        <item name="android:windowSharedElementEnterTransition">
            @transition/lb_shared_element_enter_transition
        </item>

        <item name="android:windowSharedElementReturnTransition">
            @transition/lb_shared_element_return_transition
        </item>
        <item name="android:windowEnterTransition">@transition/lb_enter_transition</item>
        <item name="android:windowReturnTransition">@transition/lb_return_transition</item>
        <item name="android:windowTransitionBackgroundFadeDuration">350</item>
    </style>

    <style name="Theme.Catapult" parent="Theme.Material3.DayNight.NoActionBar.Leanback" />

    <style name="Theme.Catapult.PreferenceTheme" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/Theme.Catapult.CategoryStyle</item>
        <item name="preferenceScreenStyle">@style/Theme.Catapult.PreferenceScreenStyle</item>
        <item name="preferenceStyle">@style/Theme.Catapult.PreferenceStyle</item>
        <item name="switchPreferenceStyle">@style/Theme.Catapult.SwitchPreferenceStyle</item>
        <item name="dropdownPreferenceStyle">@style/Theme.Catapult.DropDownPreferenceStyle</item>
        <item name="seekBarPreferenceStyle">@style/Theme.Catapult.SeekBarPreferenceStyle</item>
        <item name="dialogPreferenceStyle">@style/Theme.Catapult.DialogPreferenceStyle</item>
    </style>

    <style name="Preference_TextAppearanceMaterialSubhead">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Theme.Catapult.CategoryStyle" parent="@style/Preference.Category.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.PreferenceStyle" parent="@style/Preference.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.PreferenceScreenStyle"
        parent="@style/Preference.PreferenceScreen.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.SwitchPreferenceStyle"
        parent="@style/Preference.SwitchPreference.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.DropDownPreferenceStyle"
        parent="@style/Preference.DropDown.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.SeekBarPreferenceStyle"
        parent="Preference.SeekBarPreference.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.DialogPreferenceStyle"
        parent="@style/Preference.DialogPreference.Material">
        <item name="iconSpaceReserved">false</item>
        <item name="android:singleLineTitle">false</item>
    </style>

    <style name="Theme.Catapult.SideActivity">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@drawable/rounded_background</item>

        <item name="preferenceTheme">@style/Theme.Catapult.PreferenceTheme</item>
    </style>
</resources>