phony {
    name: "powerhint.json",
    required: [
        "powerhint.odin.json",
        "powerhint.modin.json",
        "powerhint.vali.json",
        "powerhint.fric.json",
    ],
}

prebuilt_etc {
    name: "powerhint.odin.json",
    src: "powerhint.t210.json",
    vendor: true,
}

prebuilt_etc {
    name: "powerhint.modin.json",
    src: "powerhint.t210b01.json",
    vendor: true,
}

/* NOTE: vali sets kernel-side limits so scaling is locked down */
prebuilt_etc {
    name: "powerhint.vali.json",
    src: "powerhint.t210b01.json",
    vendor: true,
}

prebuilt_etc {
    name: "powerhint.fric.json",
    src: "powerhint.t210b01.json",
    vendor: true,
}
